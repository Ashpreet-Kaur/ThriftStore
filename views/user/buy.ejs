<%- include("header.ejs") %>

<div class="rt-buy-page">
  <div style="max-width:82rem;margin:0 auto;">

    <!-- Breadcrumb -->
    <nav class="rt-breadcrumb" style="margin-bottom:1.25rem;font-size:0.85rem;display:flex;align-items:center;gap:0.5rem;">
      <a href="/">Home</a>
      <span>/</span>
      <span>Products</span>
    </nav>

    <!-- Page Heading -->
    <div style="text-align:center;margin-bottom:2.5rem;">
      <p class="hero-kicker">Sustainable fashion</p>
      <h2 style="font-family:'Playfair Display',serif;font-size:clamp(1.8rem,3.5vw,2.8rem);color:var(--text);margin-top:0.5rem;">Shop Pre-Loved Fashion</h2>
      <p style="color:var(--text-muted);margin-top:0.5rem;">Find your favorite pieces from sustainable collections.</p>
    </div>

    <div style="display:flex;flex-direction:column;gap:1.5rem;" class="buy-layout">

      <!-- Sidebar -->
      <aside class="rt-sidebar" style="width:100%;">
        <p class="rt-sidebar__heading">Browse by</p>
        <ul style="list-style:none;padding:0;margin:0;display:grid;gap:0.25rem;">

          <!-- Men -->
          <li>
            <a href="/buy?category=men"
               class="rt-sidebar-parent <%= category === 'men' ? 'active' : '' %>">Men</a>
            <% if (category === 'men' && subcategories.length) { %>
              <ul class="rt-sub-list">
                <% subcategories.forEach(sub => { %>
                  <li>
                    <a href="/buy?category=men&subcategory=<%= sub %>"
                       class="rt-sidebar-link <%= subcategory === sub ? 'active' : '' %>">
                      <%= sub %>
                    </a>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </li>

          <!-- Women -->
          <li>
            <a href="/buy?category=women"
               class="rt-sidebar-parent <%= category === 'women' ? 'active' : '' %>">Women</a>
            <% if (category === 'women' && subcategories.length) { %>
              <ul class="rt-sub-list">
                <% subcategories.forEach(sub => { %>
                  <li>
                    <a href="/buy?category=women&subcategory=<%= sub %>"
                       class="rt-sidebar-link <%= subcategory === sub ? 'active' : '' %>">
                      <%= sub %>
                    </a>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </li>

          <!-- Kids -->
          <li>
            <a href="/buy?category=kids"
               class="rt-sidebar-parent <%= category === 'kids' ? 'active' : '' %>">Kids</a>
            <% if (category === 'kids' && subcategories.length) { %>
              <ul class="rt-sub-list">
                <% subcategories.forEach(sub => { %>
                  <li>
                    <a href="/buy?category=kids&subcategory=<%= sub %>"
                       class="rt-sidebar-link <%= subcategory === sub ? 'active' : '' %>">
                      <%= sub %>
                    </a>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </li>

          <li style="margin-top:0.5rem;">
            <a href="/buy" class="rt-sidebar-link <%= !category ? 'active' : '' %>">All Products</a>
          </li>
        </ul>
      </aside>

      <!-- Product Grid -->
      <div style="flex:1;min-width:0;">
        <% if (clothes.length === 0) { %>
          <p class="rt-empty">No products available at the moment.</p>
        <% } else { %>

          <!-- Sort Bar -->
          <div class="rt-sort-bar">
            <p style="color:var(--text-muted);font-size:0.88rem;font-family:'Space Grotesk',sans-serif;">
              <span style="color:var(--teal);font-weight:700;"><%= clothes.length %></span> Products
            </p>
            <form method="GET" action="/buy" style="display:flex;align-items:center;gap:0.65rem;">
              <% if (category) { %><input type="hidden" name="category" value="<%= category %>"><% } %>
              <% if (subcategory) { %><input type="hidden" name="subcategory" value="<%= subcategory %>"><% } %>
              <label for="sort" style="font-family:'Space Grotesk',sans-serif;font-size:0.78rem;color:var(--text-muted);letter-spacing:0.1em;text-transform:uppercase;">Sort by</label>
              <select name="sort" id="sort" onchange="this.form.submit()">
                <option value="">Recommended</option>
                <option value="price_asc"  <%= sort === 'price_asc'  ? 'selected' : '' %>>Price: Low → High</option>
                <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price: High → Low</option>
                <option value="name_asc"   <%= sort === 'name_asc'   ? 'selected' : '' %>>Name: A–Z</option>
                <option value="name_desc"  <%= sort === 'name_desc'  ? 'selected' : '' %>>Name: Z–A</option>
              </select>
            </form>
          </div>

          <!-- Cards Grid -->
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1.5rem;">
            <% clothes.forEach(item => { %>
              <div class="rt-product-card" style="position:relative;">
                <div style="position:relative;overflow:hidden;">
                  <% if (item.onSale) { %>
                    <span class="rt-product-card__badge-sale">Sale</span>
                  <% } %>
                  <img
                    src="/public/product_images/<%= item.image %>"
                    alt="<%= item.itemName %>"
                    data-name="<%= item.itemName %>"
                    style="width:100%;height:15rem;object-fit:cover;transition:transform 420ms ease;display:block;"
                    onerror="rtFallback(this)"
                  />
                </div>
                <div class="rt-product-card__body">
                  <p class="rt-product-card__name"><%= item.itemName %></p>
                  <p>
                    <% if (item.new_price && item.new_price < item.price) { %>
                      <span class="rt-product-card__old-price">₹<%= item.price %></span>
                      <span class="rt-product-card__price">₹<%= item.new_price %></span>
                    <% } else { %>
                      <span class="rt-product-card__price">₹<%= item.price %></span>
                    <% } %>
                  </p>
                  <div class="rt-product-card__actions">
                    <a href="/view_product/<%= item.cloth_id %>" class="rt-btn-view">View</a>
                    <form action="/cart/add/<%= item.cloth_id %>" method="POST" style="flex:1;">
                      <button type="submit" class="rt-btn-cart" style="width:100%;">Add to Cart</button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>

        <% } %>
      </div>
    </div><!-- .buy-layout -->
  </div>
</div>

<style>
  @media (min-width: 768px) {
    .buy-layout { flex-direction: row !important; }
    .buy-layout aside.rt-sidebar { width: 16rem !important; flex-shrink: 0; }
  }
</style>

<%- include("footer.ejs") %>
