
<% newArrivals.forEach(product => { %>
  <article class="product-card reveal-on-scroll">
    <div class="product-card__image-wrap product-card__image-wrap--tall">
      <img src="/public/product_images/<%= product.image %>" alt="New Arrival" class="product-card__image" onerror="this.onerror=null;this.src='/public/images/formimage.avif';" />
      <span class="product-card__badge product-card__badge--new">New</span>
    </div>
    <div class="product-card__body">
      <h3 class="product-card__title"><%= product.itemName || product.name %></h3>
      <% if (product.new_price && product.new_price < product.price) { %>
        <div class="product-card__price-row">
          <span class="product-card__price-old">₹<%= product.price %></span>
          <span class="product-card__price">₹<%= product.new_price %></span>
        </div>
      <% } else { %>
        <p class="product-card__price">₹<%= product.price %></p>
      <% } %>

      <a href="/view_product/<%= product.cloth_id %>" class="product-card__link">View details</a>
    </div>
  </article>
<% }); %>
