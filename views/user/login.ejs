<%- include("header.ejs") %>

<main class="section-shell px-4 pb-8">
  <section class="hero-surface max-w-6xl mx-auto !grid-cols-1 lg:!grid-cols-[1fr_1fr]">
    <div>
      <p class="hero-kicker">Welcome back</p>
      <h1 class="hero-title">Sign in to continue your ReTrend journey.</h1>
      <p class="hero-description">Access your wishlist, cart, orders, and seller tools in one place.</p>

      <form method="POST" action="/login" style="display:grid;gap:1rem;margin-top:1.75rem;max-width:34rem;">
        <div>
          <label for="email" style="display:block;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--teal);margin-bottom:0.45rem;">Email address</label>
          <input type="email" id="email" name="email" required class="rt-input" style="width:100%;" placeholder="you@example.com" />
        </div>
        <div>
          <label for="password" style="display:block;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--teal);margin-bottom:0.45rem;">Password</label>
          <input type="password" id="password" name="password" required class="rt-input" style="width:100%;" placeholder="Enter your password" />
        </div>
        <button type="submit" class="hero-button hero-button--primary" style="justify-self:start;">Sign In</button>
      </form>

      <p style="margin-top:1rem;color:var(--text-soft);">
        Don&rsquo;t have an account?
        <a href="/register" style="color:var(--teal-light);text-decoration:underline;">Register here</a>
      </p>

      <% if (locals.message) { %>
        <p style="margin-top:0.9rem;color:var(--coral-light);font-weight:600;"><%= message %></p>
      <% } %>
    </div>

    <div class="hero-visual">
      <div class="hero-visual__card hero-visual__card--main">
        <img
          src="/public/images/shopNow.avif"
          alt="Sign in"
          data-name="women fashion"
          class="hero-visual__image"
          onerror="rtFallback(this)"
        />
      </div>
    </div>
  </section>
</main>

<%- include("footer.ejs") %>
