<%- include("header.ejs") %>

<div class="min-h-screen bg-gray-100 flex items-center justify-center">
  <div class="bg-white shadow-lg rounded-lg overflow-hidden flex flex-col-reverse md:flex-row w-full max-w-4xl h-[400px]">
    
    <!-- Login Form Section -->
    <div class="w-full md:w-1/2 flex items-center justify-center p-6">
      <div
        class="w-full max-w-md"
        data-aos="fade-up"
        data-aos-duration="1000"
        data-aos-delay="200"
        data-aos-easing="ease-in-out"
      >
        <h3 class="text-3xl font-bold mb-6 text-gray-800">Login</h3>
        <form method="POST" action="/login" class="space-y-3 text-lg">
          <div>
            <label for="email" class="block font-medium text-gray-900 mb-1">Email *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full border border-gray-300 rounded px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-black"
            />
          </div>

          <div>
            <label for="password" class="block font-medium text-gray-900 mb-1">Password *</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              class="w-full border border-gray-300 rounded px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-black"
            />
          </div>

          <button
            type="submit"
            class="bg-gray-800 text-white py-3 px-4 rounded w-full text-lg hover:bg-gray-800 transition-all"
          >
            Login
          </button>
        </form>

        <p class="text-center text-base mt-4 text-gray-900">
          Don’t have an account? 
          <a href="/register" class="text-blue-600 hover:underline">Register here</a>
        </p>

        <% if (locals.message) { %>
          <p class="text-center text-red-600 font-semibold mt-3"><%= message %></p>
        <% } %>
      </div>
    </div>

    <!-- Image Section -->
    <div class="w-full md:w-1/2 hidden md:block">
      <img
        src="/public/images/contact.png"
        alt="Auth"
        class="w-full h-full object-cover"
      />
    </div>

  </div>
</div>

<%- include("footer.ejs") %>
