<%- include("header.ejs") %>

<main class="section-shell px-4 pb-8">
  <section class="rt-form-shell">
    <form action="/edit_profile" method="POST" enctype="multipart/form-data" class="rt-form-card rt-form-grid" style="max-width:48rem;margin:0 auto;">
      <div>
        <p class="hero-kicker">Account center</p>
        <h2 class="section-title" style="margin-top:0.45rem;">Update Profile</h2>
      </div>

      <div class="rt-form-grid-2">
        <div>
          <label class="rt-label">Name</label>
          <input type="text" name="name" value="<%= user.name %>" required class="rt-input" style="width:100%;" />
        </div>
        <div>
          <label class="rt-label">Birthday</label>
          <input type="text" name="dob" value="<%= user.dob || '' %>" placeholder="DD-MM-YYYY" class="rt-input" style="width:100%;" />
        </div>
      </div>

      <div>
        <label class="rt-label">Gender</label>
        <div class="rt-radio-wrap">
          <label><input type="radio" name="gender" value="Male" <%= user.gender === 'Male' ? 'checked' : '' %>> Male</label>
          <label><input type="radio" name="gender" value="Female" <%= user.gender === 'Female' ? 'checked' : '' %>> Female</label>
          <label><input type="radio" name="gender" value="Other" <%= user.gender === 'Other' ? 'checked' : '' %>> Other</label>
        </div>
      </div>

      <div class="rt-form-grid-2">
        <div>
          <label class="rt-label">Phone Number</label>
          <input type="text" name="mobile" value="<%= user.mobile %>" class="rt-input" style="width:100%;" required>
        </div>
        <div>
          <label class="rt-label">Email</label>
          <input type="text" value="<%= user.email %>" disabled class="rt-input" style="width:100%;background:rgba(255,255,255,0.08);">
        </div>
      </div>

      <div>
        <label class="rt-label">Address</label>
        <textarea name="address" class="rt-input" style="width:100%;"><%= user.address %></textarea>
      </div>

      <div>
        <label class="rt-label">Change Profile Photo</label>
        <input type="file" name="photo" class="rt-input" style="width:100%;padding-top:0.55rem;padding-bottom:0.55rem;">
      </div>

      <div style="display:flex;gap:0.85rem;align-items:center;flex-wrap:wrap;">
        <button type="submit" class="hero-button hero-button--primary">Save Changes</button>
        <button type="submit" formaction="/delete_account" formmethod="POST" class="rt-danger-btn">Delete Account</button>
      </div>

      <p class="rt-note">Deleting account is permanent and cannot be undone.</p>
    </form>
  </section>
</main>

<%- include("footer.ejs") %>
