<%- include("header.ejs") %>

<div class="flex justify-center items-center px-4 py-10">
  <form action="/edit_profile" method="POST" enctype="multipart/form-data" class="w-full max-w-2xl bg-white rounded-lg shadow-md p-6 space-y-6">
    
    <h2 class="text-xl font-bold text-center">My Profile</h2>

    <!-- Name -->
    <div>
      <label class="block text-sm font-medium mb-1">*Name</label>
      <input type="text" name="name" value="<%= user.name %>" required class="w-full border border-gray-300 rounded-md px-4 py-2">
    </div>

    <!-- Birthday -->
    <div>
      <label class="block text-sm font-medium mb-1">Birthday</label>
      <input type="text" name="dob" value="<%= user.dob || '' %>" placeholder="DD-MM-YYYY" class="w-full border border-gray-300 rounded-md px-4 py-2">
    </div>

    <!-- Gender -->
    <div>
      <label class="block text-sm font-medium mb-1">Gender</label>
      <div class="flex space-x-4 mt-2">
        <label class="flex items-center space-x-1">
          <input type="radio" name="gender" value="Male" <%= user.gender === 'Male' ? 'checked' : '' %>>
          <span>Male</span>
        </label>
        <label class="flex items-center space-x-1">
          <input type="radio" name="gender" value="Female" <%= user.gender === 'Female' ? 'checked' : '' %>>
          <span>Female</span>
        </label>
        <label class="flex items-center space-x-1">
          <input type="radio" name="gender" value="Other" <%= user.gender === 'Other' ? 'checked' : '' %>>
          <span>Other</span>
        </label>
      </div>
    </div>

   
    <!-- Mobile -->
    <div>
      <label class="block text-sm font-medium mb-1">Phone Number</label>
      <input type="text" name="mobile" value="<%= user.mobile %>" class="w-full border border-gray-300 rounded-md px-4 py-2" required>
    </div>

    <!-- Email (Display only) -->
    <div>
      <label class="block text-sm font-medium mb-1">Email</label>
      <input type="text" value="<%= user.email %>" disabled class="w-full border border-gray-300 bg-gray-100 rounded-md px-4 py-2">
    </div>

    <!-- Address -->
    <div>
      <label class="block text-sm font-medium mb-1">Address</label>
      <textarea name="address" class="w-full border border-gray-300 rounded-md px-4 py-2"><%= user.address %></textarea>
    </div>

    <!-- Profile Photo Upload -->
    <div>
      <label class="block text-sm font-medium mb-1">Change Profile Photo</label>
      <input type="file" name="photo" class="w-full border border-gray-300 rounded-md px-4 py-2">
    </div>

    <!-- Submit -->
    <div class="text-center">
      <button type="submit" class="bg-black text-white px-6 py-2 rounded hover:bg-gray-800">Confirm</button>
    </div>

    <!-- Delete Account -->
    <div class="mt-6 border-t pt-4">
      <h4 class="font-semibold text-sm text-red-600 mb-1">Delete Account</h4>
      <p class="text-sm text-gray-600 mb-2">NOTE: Account will NOT BE RECOVERABLE once deleted</p>
      <button type="submit" formaction="/delete_account" formmethod="POST" class="text-red-600 underline hover:text-red-800">Confirm</button>
    </div>
  </form>
</div>

<%- include("footer.ejs") %>
