<%- include("header.ejs") %>

<main class="section-shell px-4 pb-8">
  <section class="hero-surface max-w-6xl mx-auto !grid-cols-1 lg:!grid-cols-[1fr_1fr]">
    <div>
      <p class="hero-kicker">Create account</p>
      <h1 class="hero-title">Join ReTrend and start buying or selling in style.</h1>
      <p class="hero-description">A few details and your profile is ready to explore colorful pre-loved collections.</p>

      <form method="POST" action="/user/register" enctype="multipart/form-data" style="display:grid;gap:1rem;margin-top:1.75rem;max-width:36rem;">
        <div>
          <label for="name" style="display:block;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--teal);margin-bottom:0.45rem;">Name</label>
          <input type="text" id="name" name="name" required class="rt-input" style="width:100%;" placeholder="Your full name" />
        </div>

        <div>
          <label for="email" style="display:block;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--teal);margin-bottom:0.45rem;">Email</label>
          <input type="email" id="email" name="email" required class="rt-input" style="width:100%;" placeholder="you@example.com" />
        </div>

        <div>
          <span style="display:block;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--teal);margin-bottom:0.45rem;">Gender</span>
          <div style="display:flex;align-items:center;gap:1rem;color:var(--text-soft);">
            <label style="display:inline-flex;align-items:center;gap:0.45rem;">
              <input type="radio" name="gender" value="male" /> Male
            </label>
            <label style="display:inline-flex;align-items:center;gap:0.45rem;">
              <input type="radio" name="gender" value="female" /> Female
            </label>
          </div>
        </div>

        <div>
          <label for="mobile" style="display:block;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--teal);margin-bottom:0.45rem;">Mobile</label>
          <input type="text" id="mobile" name="mobile" class="rt-input" style="width:100%;" placeholder="Phone number" />
        </div>

        <div>
          <label for="address" style="display:block;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--teal);margin-bottom:0.45rem;">Address</label>
          <textarea id="address" name="address" rows="2" class="rt-input" style="width:100%;" placeholder="City, street, etc."></textarea>
        </div>

        <div>
          <label for="photo" style="display:block;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--teal);margin-bottom:0.45rem;">Profile Photo</label>
          <input type="file" id="photo" name="photo" class="rt-input" style="width:100%;padding-top:0.55rem;padding-bottom:0.55rem;" />
        </div>

        <div>
          <label for="password" style="display:block;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--teal);margin-bottom:0.45rem;">Password</label>
          <input type="password" id="password" name="password" required class="rt-input" style="width:100%;" placeholder="Create a password" />
        </div>

        <button type="submit" class="hero-button hero-button--primary" style="justify-self:start;">Create Account</button>
      </form>

      <p style="margin-top:1rem;color:var(--text-soft);">
        Already have an account?
        <a href="/login" style="color:var(--teal-light);text-decoration:underline;">Login here</a>
      </p>

      <% if (locals.result) { %>
        <p style="margin-top:0.9rem;color:var(--coral-light);font-weight:600;"><%= result %></p>
      <% } %>
    </div>

    <div class="hero-visual">
      <div class="hero-visual__card hero-visual__card--main">
        <img
          src="/public/images/shopNow.avif"
          alt="Register"
          data-name="women dress fashion"
          class="hero-visual__image"
          onerror="rtFallback(this)"
        />
      </div>
    </div>
  </section>
</main>

<%- include("footer.ejs") %>
