<%- include("header.ejs") %>

<div class="max-w-3xl mx-auto my-10 px-6">
  <div class="flex min-w-72 gap-3 mx-4 items-center">
    <a href="/profile" class="inline-flex items-center text-gray-700 hover:text-blue-600 transition">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
    </a>
    <h2 class="text-2xl font-bold text-gray-800">Shipping Address</h2>
  </div>

  <% if (user) { %>
    <div class="bg-white p-6 rounded-xl shadow space-y-4 mt-4">
      <p class="text-lg text-gray-800"><strong>Name:</strong> <%= user.name || "Not Provided" %></p>
      <p class="text-gray-700"><strong>Address:</strong> <%= user.address %></p>

      <div class="flex gap-4 mt-4">
        <a href="/address" class="inline-flex items-center px-4 py-2 bg-gray-800 text-white rounded shadow hover:bg-gray-700 transition">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          Add Address
        </a>
        <a href="/user/edit_address" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded shadow hover:bg-blue-500 transition">
          Change
        </a>
      </div>
    </div>
  <% } else { %>
    <div class="bg-gray-100 text-center p-10 rounded-xl shadow mt-4">
      <p class="text-gray-600 text-lg mb-4">No address added yet.</p>
      <a href="/addAddress" class="inline-flex items-center px-5 py-2 bg-green-600 text-white rounded shadow hover:bg-green-500 transition">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Add Address
      </a>
    </div>
  <% } %>
</div>

<%- include("footer.ejs") %>
