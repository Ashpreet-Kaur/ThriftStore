<%- include("header.ejs") %>

<% if (message) { %>
  <div class="max-w-xl mx-auto mt-6 px-4 py-3" style="background:var(--teal-dim);color:var(--teal-light);border:1px solid var(--border-teal);border-radius:0.8rem;">
    <%= message %>
  </div>
<% } %>

<main class="section-shell px-4 pb-8">
  <section class="rt-form-shell" style="max-width:44rem;">
  <div class="flex min-w-72 gap-3" style="margin-bottom:0.8rem;">
            <span>
              <a href="/profile" class="inline-flex items-center" style="color:var(--text-soft);">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 mt-1">
  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
</svg>

              </a>
            </span>
            <h2 class="section-title" style="font-size:1.9rem;">Change Password</h2>
          </div>
  <form action="/change_password" method="POST" class="rt-form-card rt-form-grid">
    <div>
      <label for="currentPassword" class="rt-label">Current Password</label>
      <input type="password" name="currentPassword" id="currentPassword"
        class="rt-input"
        style="width:100%;"
        required />
    </div>

    <div>
      <label for="newPassword" class="rt-label">New Password</label>
      <input type="password" name="newPassword" id="newPassword"
        class="rt-input"
        style="width:100%;"
        required />
    </div>

    <div>
      <label for="confirmPassword" class="rt-label">Confirm New Password</label>
      <input type="password" name="confirmPassword" id="confirmPassword"
        class="rt-input"
        style="width:100%;"
        required />
    </div>

    <button type="submit" class="hero-button hero-button--primary" style="justify-self:start;">
      Update Password
    </button>
  </form>
  </section>
</main>

<%- include("footer.ejs") %>
