<%- include("header.ejs") %>

<% if (message) { %>
  <div class="max-w-xl mx-auto mt-6 px-4 py-3 bg-green-100 text-green-800 rounded shadow">
    <%= message %>
  </div>
<% } %>

<div class="max-w-xl mx-auto mt-10 px-6 mb-12">
  <div class="flex min-w-72 gap-3">
    <span>
      <a href="/shipping_address" class="inline-flex items-center text-gray-700 hover:text-blue-600 mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
          stroke="currentColor" class="size-6 mt-1">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
      </a>
    </span>
    <h2 class="text-2xl font-bold text-gray-700 mb-8">Add Shipping Address</h2>
  </div>

  <form action="/addAddress" method="POST"
    class="bg-white p-6 rounded-lg shadow space-y-5">
    <div>
      <label for="address" class="block text-gray-700 mb-1">Enter Address</label>
      <textarea name="address" id="address" rows="4"
        class="w-full border border-gray-300 px-4 py-2 rounded resize-none focus:outline-none focus:ring-2 focus:ring-black"
        placeholder="123, Street Name, City, State, Zip Code" required></textarea>
    </div>

    <button type="submit"
      class="w-full bg-black text-white py-2 px-4 rounded hover:bg-gray-900 transition duration-200">
      Save Address
    </button>
  </form>
</div>

<%- include("footer.ejs") %>
