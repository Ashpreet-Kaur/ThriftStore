<%- include("header.ejs") %>

<% if (message) { %>
  <div class="max-w-xl mx-auto mt-6 px-4 py-3" style="background:var(--teal-dim);color:var(--teal-light);border:1px solid var(--border-teal);border-radius:0.8rem;">
    <%= message %>
  </div>
<% } %>

<main class="section-shell px-4 pb-8">
  <section class="rt-form-shell" style="max-width:44rem;">
  <div class="flex min-w-72 gap-3" style="margin-bottom:0.8rem;">
    <span>
      <a href="/shipping_address" class="inline-flex items-center" style="color:var(--text-soft);">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
          stroke="currentColor" class="size-6 mt-1">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
      </a>
    </span>
    <h2 class="section-title" style="font-size:1.9rem;">Add Shipping Address</h2>
  </div>

  <form action="/addAddress" method="POST" class="rt-form-card rt-form-grid">
    <div>
      <label for="address" class="rt-label">Enter Address</label>
      <textarea name="address" id="address" rows="4"
        class="rt-input"
        style="width:100%;"
        placeholder="123, Street Name, City, State, Zip Code" required></textarea>
    </div>

    <button type="submit" class="hero-button hero-button--primary" style="justify-self:start;">
      Save Address
    </button>
  </form>
  </section>
</main>

<%- include("footer.ejs") %>
