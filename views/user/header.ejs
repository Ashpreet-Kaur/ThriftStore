<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ReTrend</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Font -->
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/public/css/style.css" />
  <link rel="stylesheet" href="/public/css/retrend-ui.css" />
</head>

<body class="retrend-shell bg-stone-50 text-slate-900">
  <div class="ambient-orb ambient-orb-one"></div>
  <div class="ambient-orb ambient-orb-two"></div>
  <nav class="site-nav px-4 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      <a href="/" class="brand-mark">
        <span class="brand-mark__title">ReTrend</span>
        <span class="brand-mark__subtitle">Second life for standout style</span>
      </a>

      <button
        id="menu-toggle"
        class="menu-toggle md:hidden focus:outline-none"
        type="button"
        aria-label="Toggle navigation"
      >
        <div class="w-6 h-0.5 bg-white mb-1"></div>
        <div class="w-6 h-0.5 bg-white mb-1"></div>
        <div class="w-6 h-0.5 bg-white"></div>
      </button>

      <div
        id="menu"
        class="menu-panel hidden md:flex flex-col md:flex-row md:items-center gap-3 md:gap-6 text-gray-50 text-base md:text-lg mt-4 md:mt-0"
      >
        <a href="/" class="nav-link">Home</a>
        <a href="/buy" class="nav-link">Explore</a>
        <a href="/about" class="nav-link">About</a>
        <a href="/contact" class="nav-link">Contact</a>
        <a href="/cart" class="nav-link">Cart</a>

        <% if (user) { %>
          <a href="/sell" class="nav-link">Sell</a>
          <a href="/profile" class="nav-link">Profile</a>
          <a href="/logout" class="nav-link nav-link--cta">Logout</a>
        <% } else { %>
          <a href="/login" class="nav-link nav-link--cta flex items-center gap-1 justify-center">
            Sign In
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
              stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.25a8.25 8.25 0 0115 0" />
            </svg>
          </a>
        <% } %>
      </div>
    </div>
  </nav>

  <script>
    const menuToggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('menu');

    if (menuToggle && menu) {
      menuToggle.addEventListener('click', function () {
        menu.classList.toggle('hidden');
        menu.classList.toggle('menu-panel--open');
      });
    }
  </script>
