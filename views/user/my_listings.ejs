<%- include("header.ejs") %>

<div class="container profile-container d-block mt-5 section-shell px-3">
  <div class="flex min-w-72 gap-3 mx-8 mt-4">
    <span>
      <a href="/profile" class="inline-flex items-center text-gray-700 hover:text-blue-600 mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 mt-1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
      </a>
    </span>
    <h2 class="section-title" style="font-size:2rem;">My Listings</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 m-8">
    <% clothes.forEach(item => { %>
      <div class="rt-product-card h-[70vh] text-center w-72" style="padding:0.4rem;">
        <img src="/public/product_images/<%= item.image %>" alt="<%= item.name %>" data-name="<%= item.name %>" class="w-full h-80 object-contain rounded my-2" onerror="rtFallback(this)">
        <h3 class="rt-product-card__name" style="padding:0 0.6rem;"><%= item.name %></h3>
        <p class="rt-product-card__price">₹ <%= item.price %></p>
        <p class="text-sm" style="color:var(--text-soft);">
          Status:
          <% if (item.status === 'approved') { %>
            <span class="text-green-600 font-medium">Approved</span>
          <% } else if (item.status === 'pending') { %>
            <span class="text-yellow-600 font-medium">Pending</span>
          <% } else if (item.status === 'rejected') { %>
            <span class="text-red-600 font-medium">Rejected</span>
          <% } %>
        </p>
        <div class="rt-product-card__actions" style="padding:0 0.6rem 0.8rem;">
          <a href="/edit_listing/<%= item.cloth_id %>">
            <button type="button" class="rt-btn-view" style="width:100%;">
              Change
            </button>
          </a>
          <form action="/delete_listing/<%= item.cloth_id %>" method="POST" class="inline-block" style="flex:1;">
            <button type="submit" class="rt-btn-cart" style="width:100%;">
              Delete
            </button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<%- include("footer.ejs") %>
