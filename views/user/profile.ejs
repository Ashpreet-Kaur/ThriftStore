<%- include("header.ejs") %>

<main class="rt-profile-page">
  <div class="rt-profile-shell">
    <section class="rt-profile-card rt-profile-head">
      <div class="rt-profile-avatar">
        <% if (user.photo) { %>
          <img src="/public/user_image/<%= user.photo %>" alt="Profile Photo" onerror="this.onerror=null;this.src='/public/images/default-profile.jpg';" />
        <% } else { %>
          <img src="/public/images/default-profile.jpg" alt="Default Profile" />
        <% } %>
      </div>
      <div>
        <p class="hero-kicker">User Dashboard</p>
        <h1 class="rt-profile-name">Welcome, <%= user.name %></h1>
        <p class="rt-profile-email"><%= user.email %></p>
      </div>
    </section>

    <section class="rt-profile-card rt-profile-stats">
      <article class="rt-stat-tile">
        <p class="rt-stat-value">736</p>
        <p class="rt-stat-label">Points</p>
      </article>
      <article class="rt-stat-tile">
        <p class="rt-stat-value">1</p>
        <p class="rt-stat-label">Coupons</p>
      </article>
      <article class="rt-stat-tile">
        <p class="rt-stat-value">₹0</p>
        <p class="rt-stat-label">Wallet</p>
      </article>
      <article class="rt-stat-tile">
        <p class="rt-stat-value">6</p>
        <p class="rt-stat-label">Wishlist</p>
      </article>
    </section>

    <section class="rt-profile-card">
      <h2 class="rt-profile-section-title">My Account</h2>
      <div class="rt-profile-links">
        <a href="/edit_profile" class="rt-profile-link">My Profile</a>
        <a href="/my_listings" class="rt-profile-link">My Listings</a>
        <span class="rt-profile-link rt-profile-link--muted">My Reviews</span>
        <a href="/settings" class="rt-profile-link">Settings</a>
      </div>
    </section>

    <section class="rt-profile-card">
      <h2 class="rt-profile-section-title">Help Center</h2>
      <div class="rt-profile-links">
        <a href="/return_policy" class="rt-profile-link">Return Policy</a>
        <a href="/shipping" class="rt-profile-link">Shipping & Delivery</a>
      </div>
    </section>
  </div>
</main>

<%- include("footer.ejs") %>
