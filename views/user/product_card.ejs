<div class="rt-product-card" style="position:relative;">
  <div class="product-card__image-wrap" style="position:relative;overflow:hidden;">
    <img
      src="/public/product_images/<%= product.image %>"
      alt="<%= product.name %>"
      data-name="<%= product.name %>"
      class="product-card__image"
      onerror="rtFallback(this)"
    />
  </div>
  <div class="rt-product-card__body">
    <p class="rt-product-card__name"><%= product.name %></p>
    <p class="rt-product-card__price">₹ <%= product.price %></p>
    <div class="rt-product-card__actions">
      <a href="<%= isLoggedIn ? '/buy/' + product.id : '/login' %>" class="rt-btn-view">View</a>
    </div>
  </div>
</div>

