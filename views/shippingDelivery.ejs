<%- include("user/user_header.ejs") %>
<main class="rt-policy-page">
  <div class="rt-policy-shell">
    <div class="rt-policy-header">
      <a href="/profile" class="rt-policy-back" aria-label="Back to profile">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.5 19.5L3 12l7.5-7.5M3 12h18" />
        </svg>
      </a>
      <div>
        <p class="hero-kicker">Support</p>
        <h1 class="rt-policy-title">Shipping and Delivery</h1>
      </div>
    </div>

    <p class="rt-policy-intro">We strive to deliver your orders as quickly and safely as possible. Here is everything you need to know about our shipping and delivery process.</p>

    <section class="rt-policy-section">
      <h2 class="rt-policy-heading">Shipping Details</h2>

      <% const shippingInfo = [
        { title: "Shipping Time", desc: "Orders are usually shipped within 1-2 business days after confirmation." },
        { title: "Delivery Time", desc: "Delivery typically takes 3-7 business days, depending on your location." },
        { title: "Free Shipping", desc: "We offer free standard shipping on orders above INR 499." }
      ] %>

      <% shippingInfo.forEach(info => { %>
      <article class="rt-policy-item">
        <span class="rt-policy-icon">✓</span>
        <div>
          <h3><%= info.title %></h3>
          <p><%= info.desc %></p>
        </div>
      </article>
      <% }) %>
    </section>

    <section class="rt-policy-section">
      <h2 class="rt-policy-heading">Tracking and Support</h2>

      <% const supportInfo = [
        { title: "Order Tracking", desc: "Track your order using the tracking link sent via email or SMS upon dispatch." },
        { title: "Delivery Support", desc: "Facing issues with your delivery? Contact our support team for assistance." }
      ] %>

      <% supportInfo.forEach(info => { %>
      <article class="rt-policy-item">
        <span class="rt-policy-icon">✓</span>
        <div>
          <h3><%= info.title %></h3>
          <p><%= info.desc %></p>
        </div>
      </article>
      <% }) %>
    </section>
  </div>
</main>
<%- include("user/footer.ejs") %>
