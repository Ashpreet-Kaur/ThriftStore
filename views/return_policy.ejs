<%- include("user/user_header.ejs") %>
<main class="rt-policy-page">
  <div class="rt-policy-shell">
    <div class="rt-policy-header">
      <a href="/profile" class="rt-policy-back" aria-label="Back to profile">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.5 19.5L3 12l7.5-7.5M3 12h18" />
        </svg>
      </a>
      <div>
        <p class="hero-kicker">Support</p>
        <h1 class="rt-policy-title">Return Policy</h1>
      </div>
    </div>

    <p class="rt-policy-intro">Your satisfaction is our priority. If you're not completely happy with your purchase, our return policy makes it easy and hassle-free.</p>

    <section class="rt-policy-section">
      <h2 class="rt-policy-heading">Return Conditions</h2>

      <article class="rt-policy-item">
        <span class="rt-policy-icon">✓</span>
        <div>
          <h3>Time Frame</h3>
          <p>Items must be returned within 10 days of delivery to be eligible for a refund or exchange.</p>
        </div>
      </article>

      <article class="rt-policy-item">
        <span class="rt-policy-icon">✓</span>
        <div>
          <h3>Original Condition</h3>
          <p>Products should be unused, unwashed, and in their original packaging with tags still attached.</p>
        </div>
      </article>

      <article class="rt-policy-item">
        <span class="rt-policy-icon">✓</span>
        <div>
          <h3>Non-Returnable Items</h3>
          <p>Innerwear, clearance sale items, and customized products are not eligible for returns.</p>
        </div>
      </article>
    </section>

    <section class="rt-policy-section">
      <h2 class="rt-policy-heading">Return Process</h2>

      <article class="rt-policy-item">
        <span class="rt-policy-icon">1</span>
        <div>
          <h3>Submit a Return Request</h3>
          <p>Go to your order history and click Return to initiate the request.</p>
        </div>
      </article>

      <article class="rt-policy-item">
        <span class="rt-policy-icon">2</span>
        <div>
          <h3>Pack and Ship</h3>
          <p>Use the provided shipping label and drop off the item at the nearest courier service.</p>
        </div>
      </article>

      <article class="rt-policy-item">
        <span class="rt-policy-icon">3</span>
        <div>
          <h3>Refund Process</h3>
          <p>Once the item is received and verified, the refund will be issued within 5-7 business days.</p>
        </div>
      </article>
    </section>
  </div>
</main>

<%- include("user/footer.ejs") %>
