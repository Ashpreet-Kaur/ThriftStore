<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ReTrend Admin</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/public/css/admin-ui.css" />
  </head>

  <body class="admin-shell">
    <nav class="admin-nav px-4 py-4 shadow">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <a href="/admin/admin_dashboard" class="admin-brand">
          <span class="admin-brand__title">ReTrend Admin</span>
          <span class="admin-brand__subtitle">Approvals, inventory, and control</span>
        </a>

        <!-- Mobile Toggle -->
        <button id="admin-menu-toggle" class="text-white md:hidden focus:outline-none">
          <div class="w-6 h-0.5 bg-white mb-1"></div>
          <div class="w-6 h-0.5 bg-white mb-1"></div>
          <div class="w-6 h-0.5 bg-white"></div>
        </button>

        <!-- Menu -->
        <div id="admin-menu" class="admin-menu hidden md:flex flex-col md:flex-row md:items-center space-y-4 md:space-y-0 md:space-x-3 text-white text-base mt-4 me-4 md:mt-0">
   
          <a href="/admin/admin_dashboard" class="admin-link">Dashboard</a>

          <div class="relative group">
            <button class="admin-link focus:outline-none">Requests</button>
            <div class="absolute hidden group-hover:block bg-white text-black shadow rounded mt-2 right-0 z-10 min-w-max">
              <a href="/admin/seller_requests" class="block px-4 py-2 hover:bg-gray-100">Seller Requests</a>
              <a href="/admin/pending_clothes" class="block px-4 py-2 hover:bg-gray-100">Product Requests</a>
            </div>
          </div>

          <a href="/admin/products" class="admin-link">Products</a>
       
    <a href="/admin/logout" class="admin-link admin-link--cta">Logout</a>

</div>

        </div>
      </div>
    </nav>

