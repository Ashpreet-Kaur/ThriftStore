<%- include("admin_header.ejs") %>

<main class="admin-page max-w-7xl mx-auto px-4 py-8">
 <div class="admin-panel p-8">
 <div class="flex items-center gap-3 mb-6 mx-4">
      <a href="/admin/admin_dashboard" class="inline-flex items-center text-gray-700 hover:text-blue-600 transition">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
      </a>
      <div>
        <p class="admin-chip">Product approvals</p>
        <h2 class="text-2xl font-bold text-gray-800 mt-3">Pending Product Requests</h2>
      </div>
    </div>

  <% if (clothes.length === 0) { %>
    <p class="text-gray-600">No pending products found.</p>
  <% } else { %>
    <div class="overflow-x-auto rounded-3xl bg-white/70 border border-slate-200/70 shadow-sm">
      <table class="admin-table text-left text-sm">
        <thead class="bg-gray-100 text-gray-700 uppercase text-xs">
          <tr>
            <th class="px-4 py-3 border">Item Name</th>
            <th class="px-4 py-3 border">Section</th>
            <th class="px-4 py-3 border">Category</th>
            <th class="px-4 py-3 border">Size</th>
            <th class="px-4 py-3 border">Condition</th>
            <th class="px-4 py-3 border">Price</th>
            <th class="px-4 py-3 border">Description</th>
            <th class="px-4 py-3 border">Image</th>
            <th class="px-4 py-3 border">Action</th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <% clothes.forEach(cloth => { %>
            <tr class="hover:bg-gray-50 transition border-b">
              <td class="px-4 py-2 border"><%= cloth.itemName %></td>
              <td class="px-4 py-2 border"><%= cloth.section %></td>
              <td class="px-4 py-2 border"><%= cloth.category %></td>
              <td class="px-4 py-2 border"><%= cloth.size %></td>
              <td class="px-4 py-2 border"><%= cloth.ccondition %></td>
              <td class="px-4 py-2 border">₹<%= cloth.price %></td>
              <td class="px-4 py-2 border max-w-[200px] break-words"><%= cloth.description %></td>
              <td class="px-4 py-2 border">
                <% if (cloth.image) { %>
                  <img src="/public/product_images/<%= cloth.image %>" alt="Product Image" class="w-24 h-24 object-cover rounded" onerror="this.onerror=null;this.src='/public/images/formimage.avif';" />
                <% } else { %>
                  <span class="text-gray-500">No image</span>
                <% } %>
              </td>
              <td class="px-4 py-2 border space-y-2">
                <form action="/admin/approve-cloth" method="POST">
                  <input type="hidden" name="cloth_id" value="<%= cloth.cloth_id %>" />
                  <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-sm w-full">
                    Approve
                  </button>
                </form>
                <form action="/admin/reject-cloth" method="POST">
                  <input type="hidden" name="cloth_id" value="<%= cloth.cloth_id %>" />
                  <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-sm w-full">
                    Reject
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
 </div>
</main>

<%- include("admin_footer.ejs") %>
